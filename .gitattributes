# Source files use LF everywhere (Windows included); only .bat/.cmd keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary
*.jar binary
*.apk binary
*.aab binary
*.so binary
*.dll binary
*.exe binary
*.jks binary
*.keystore binary
*.pfx binary
*.p12 binary
